{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Little Chewz Companion Source v1",
  "type": "object",
  "required": [
    "resource_id",
    "resource_type",
    "title",
    "section",
    "blocks",
    "review_status"
  ],
  "properties": {
    "resource_id": {
      "type": "string"
    },
    "resource_type": {
      "const": "teacher_companion"
    },
    "title": {
      "type": "string"
    },
    "section": {
      "type": "string"
    },
    "stage": {
      "type": "string"
    },
    "audience": {
      "const": "teacher"
    },
    "review_status": {
      "type": "string"
    },
    "eyebrow": {
      "type": "string"
    },
    "time": {
      "type": "string"
    },
    "intro": {
      "type": "string"
    },
    "blocks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "type"
        ],
        "properties": {
          "type": {
            "enum": [
              "paragraph",
              "steps",
              "questions",
              "bullets",
              "heading",
              "note",
              "image",
              "links",
              "spacer"
            ]
          }
        }
      }
    }
  },
  "additionalProperties": true
}
