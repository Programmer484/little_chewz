{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Little Chewz Lesson Source v1",
  "type": "object",
  "required": [
    "key",
    "title",
    "grade",
    "duration",
    "goal",
    "outcomes",
    "core",
    "optional_prep",
    "focus",
    "curriculum",
    "cover",
    "output",
    "steps"
  ],
  "properties": {
    "key": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "grade": {
      "type": "string"
    },
    "duration": {
      "type": "string"
    },
    "print_note": {
      "type": "string"
    },
    "goal": {
      "type": "string"
    },
    "outcomes": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1
    },
    "core": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/reference"
      }
    },
    "optional_prep": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/reference"
      }
    },
    "prep_note": {
      "type": "string"
    },
    "prep_heading": {
      "type": "string"
    },
    "focus": {
      "type": "string"
    },
    "curriculum": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "cover": {
      "type": "string"
    },
    "output": {
      "type": "string"
    },
    "assessment": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "string"
        },
        {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      ]
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "title",
          "mins",
          "rows"
        ],
        "properties": {
          "id": {
            "type": "integer",
            "minimum": 1
          },
          "title": {
            "type": "string"
          },
          "mins": {
            "type": "string"
          },
          "rows": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": [
                "kind"
              ],
              "properties": {
                "kind": {
                  "type": "string"
                },
                "text": {
                  "type": "string"
                },
                "ref": {
                  "type": "string"
                },
                "description": {
                  "type": "string"
                },
                "bold_text": {
                  "type": "string"
                },
                "links": {
                  "type": "array",
                  "items": {
                    "$ref": "#/$defs/reference"
                  }
                }
              }
            }
          }
        }
      }
    },
    "bonuses": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/reference"
      }
    },
    "bonus_heading": {
      "type": "string"
    }
  },
  "$defs": {
    "reference": {
      "type": "object",
      "required": [
        "ref"
      ],
      "properties": {
        "ref": {
          "type": "string"
        },
        "description": {
          "type": "string"
        }
      }
    }
  },
  "additionalProperties": true
}
