{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "little-chewz-print-pack-builder",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "binding": "ASSETS",
    // The React build. Unknown paths fall back to index.html so /lesson/<id> deep links work.
    "not_found_handling": "single-page-application",
    // API routes always reach the Worker, never the static-asset fallback.
    "run_worker_first": ["/api/*"]
  },
  "observability": { "enabled": true },
  // The pilot runs on the workers.dev URL behind Cloudflare Access. Version preview
  // URLs are off so no second, unprotected hostname serves the app.
  "workers_dev": true,
  "preview_urls": false,
  "vars": {
    // "drive": real allowlisted worksheets from Google Drive. Returns "credentials not
    //   configured" until the GOOGLE_SERVICE_ACCOUNT_JSON secret is set.
    // "demo": synthetic fixtures and placeholder pages only; no Google access.
    // "disabled": no worksheet bytes are served.
    // Local `npm run dev` uses .dev.vars (demo) instead of this value.
    "RESOURCE_MODE": "drive",
    // "false": no login. Allowed because every allowlisted file is a published Drive file
    // already shared "anyone with the link". Review (holding) files are still refused.
    // Set to "true" and fill in the Access settings below to require a pilot login.
    "REQUIRE_ACCESS": "false",
    // Cloudflare Access application settings (only used when REQUIRE_ACCESS is not "false").
    "ACCESS_TEAM_DOMAIN": "",
    "ACCESS_AUD": ""
  }
  // Secret (never in this file): GOOGLE_SERVICE_ACCOUNT_JSON
  // Set with: npx wrangler secret put GOOGLE_SERVICE_ACCOUNT_JSON
}
